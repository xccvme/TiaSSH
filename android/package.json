{
  "name": "tiassh-android",
  "displayName": "TiaSSH",
  "version": "1.0.0",
  "private": true,
  "license": "WTFPL",
  "scripts": {
    "sync": "cap sync android",
    "build:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk-release": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "capacitor": {
    "appId": "com.tiassh.app",
    "appName": "TiaSSH",
    "webDir": "../web",
    "android": {
      "allowMixedContent": true,
      "backgroundColor": "#0f1117"
    },
    "server": {
      "androidScheme": "https"
    }
  }
}
